<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка рецепта: скруглённая, с рамкой, фото слева, чип категории и текст справа -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_padding"
    android:layout_marginVertical="@dimen/spacing_small"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/card_radius_large"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="@dimen/stroke_width">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/card_inner_padding">

        <!-- Фото блюда слева. Пока фото нет, видна цветная заглушка -->
        <ImageView
            android:id="@+id/recipeImage"
            android:layout_width="@dimen/image_size"
            android:layout_height="@dimen/image_size"
            android:background="?attr/colorSurfaceVariant"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Чип категории: маленькая пилюля над названием -->
        <TextView
            android:id="@+id/recipeCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_inner_padding"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="@dimen/chip_padding_horizontal"
            android:paddingVertical="@dimen/spacing_xsmall"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/recipeImage"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Название рецепта -->
        <TextView
            android:id="@+id/recipeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_inner_padding"
            android:layout_marginTop="@dimen/spacing_small"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/recipeImage"
            app:layout_constraintTop_toBottomOf="@+id/recipeCategory" />

        <!-- Время готовки: более тихий цвет, чтобы не спорил с названием -->
        <TextView
            android:id="@+id/recipeTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_inner_padding"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_small"
            app:layout_constraintStart_toEndOf="@+id/recipeImage"
            app:layout_constraintTop_toBottomOf="@+id/recipeTitle" />

        <!-- Кнопка удаления: текстовая, цвет ошибки, справа внизу -->
        <Button
            android:id="@+id/deleteButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:minHeight="40dp"
            android:text="@string/delete_recipe"
            android:textColor="?attr/colorError"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/recipeImage" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>